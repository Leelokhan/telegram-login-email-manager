[Unit]
Description=Telegram Rebind Email Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/rebind-email-bot
EnvironmentFile=/root/rebind-email-bot/.env
ExecStart=/root/rebind-email-bot/venv/bin/python3 rebind_email_bot.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
